{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenglorylab.local/schemas/source-registry.schema.json",
  "title": "Golden Glory Lab Source Registry",
  "description": "Evidence sources used by current workflow records, audits, and curated data.",
  "type": "object",
  "required": [
    "schemaVersion",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "sourceClass",
        "accessedDate",
        "supportedClaimsOrRecords",
        "verificationStatus",
        "limitations"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "url"
          ]
        },
        {
          "required": [
            "repositoryPath"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "Stable, human-readable identifier, for example pob-item-sets-3-25."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "sourceClass": {
          "type": "string",
          "enum": [
            "official-ggg",
            "extracted-game-data",
            "pob-source",
            "extraction-project",
            "reference-site",
            "community-research",
            "observed-instance",
            "workflow-documentation",
            "derived"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1
        },
        "publisherOrRepository": {
          "type": "string",
          "minLength": 1
        },
        "gameOrSoftwareVersion": {
          "type": "string",
          "minLength": 1
        },
        "accessedDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "supportedClaimsOrRecords": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "confirmed",
            "supported",
            "provisional",
            "unknown",
            "superseded"
          ]
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "supersededBy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "contentHash": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
