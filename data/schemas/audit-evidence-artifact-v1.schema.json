{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenglorylab.local/schemas/audit-evidence-artifact-v1.schema.json",
  "title": "Golden Glory Lab audit evidence artifact",
  "description": "Shared envelope for small, reviewed first-release audit artifacts. It preserves claim-level provenance and retention constraints without turning an audit fixture into production mechanics data.",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifactId",
    "artifactType",
    "auditId",
    "contractVersion",
    "targetGameVersion",
    "verificationStatus",
    "sourceIds",
    "scope",
    "retention",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "artifactType": {
      "type": "string",
      "enum": [
        "manual-input-contract",
        "source-catalog",
        "mechanic-reference",
        "calculation-gate-fixture"
      ]
    },
    "auditId": {
      "type": "string",
      "enum": [
        "AUD-002",
        "AUD-003",
        "AUD-004",
        "AUD-005"
      ]
    },
    "contractVersion": {
      "const": "1.0.0"
    },
    "targetGameVersion": {
      "const": "Path of Exile 1 3.29.1"
    },
    "verificationStatus": {
      "$ref": "#/$defs/status"
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceId"
      }
    },
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "retention": {
      "$ref": "#/$defs/retention"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "supported",
        "provisional",
        "unknown",
        "superseded"
      ]
    },
    "sourceId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^AUD-00[2-5]-C[0-9]{2}$"
    },
    "retention": {
      "type": "object",
      "required": [
        "sourceLicense",
        "dataLicense",
        "provenance",
        "redistribution",
        "derivation",
        "attribution",
        "retainedMaterial",
        "notVendored",
        "uncertainty"
      ],
      "additionalProperties": false,
      "properties": {
        "sourceLicense": {
          "type": "string",
          "minLength": 1
        },
        "dataLicense": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string",
          "minLength": 1
        },
        "redistribution": {
          "type": "string",
          "minLength": 1
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "retainedMaterial": {
          "type": "string",
          "minLength": 1
        },
        "notVendored": {
          "type": "string",
          "minLength": 1
        },
        "uncertainty": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "verificationStatus",
        "claimIds",
        "sourceIds",
        "evidenceLocation",
        "limitations",
        "loadBearing",
        "downstreamConsumers",
        "replacementRule",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "verificationStatus": {
          "$ref": "#/$defs/status"
        },
        "claimIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/claimId"
          }
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sourceId"
          }
        },
        "evidenceLocation": {
          "type": "string",
          "minLength": 1
        },
        "limitations": {
          "type": "string",
          "minLength": 1
        },
        "loadBearing": {
          "type": "boolean"
        },
        "downstreamConsumers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "replacementRule": {
          "type": "string",
          "minLength": 1
        },
        "data": {
          "type": "object",
          "minProperties": 1
        }
      }
    }
  }
}
