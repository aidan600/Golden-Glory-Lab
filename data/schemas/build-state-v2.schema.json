{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenglorylab.local/schemas/build-state-v2.schema.json",
  "title": "Golden Glory Lab build state v2",
  "description": "Canonical BUILD-002 user-authored content. Recognition, reviews, gates, calculations, paths, dirty state, and migration state are derived and excluded.",
  "type": "object",
  "required": [
    "documentType",
    "schemaVersion",
    "applicationDataContractVersion",
    "importerContractVersion",
    "importedResult",
    "importedResultSha256",
    "playerItemSetOccurrenceId",
    "mercenarySourceMode",
    "mercenaryItemSetOccurrenceId",
    "manualMercenaryEquipment",
    "copiedItemEntries",
    "enmityManualInput",
    "userNotes"
  ],
  "additionalProperties": false,
  "properties": {
    "documentType": {
      "const": "golden-glory-lab-build-state"
    },
    "schemaVersion": {
      "const": "2.0.0"
    },
    "applicationDataContractVersion": {
      "const": "2.0.0"
    },
    "importerContractVersion": {
      "const": "1.0.0"
    },
    "importedResult": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "pob-neutral-import-v1.schema.json"
        }
      ]
    },
    "importedResultSha256": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "playerItemSetOccurrenceId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "mercenarySourceMode": {
      "enum": [
        "not-yet-selected",
        "mapped-item-set",
        "manual-equipment"
      ]
    },
    "mercenaryItemSetOccurrenceId": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "manualMercenaryEquipment": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/manualEquipment"
      }
    },
    "copiedItemEntries": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/copiedItem"
      }
    },
    "enmityManualInput": {
      "$ref": "#/$defs/enmityManualInput"
    },
    "userNotes": {
      "type": "string",
      "maxLength": 100000
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "importedResult": {
            "type": "null"
          }
        },
        "required": [
          "importedResult"
        ]
      },
      "then": {
        "properties": {
          "importedResultSha256": {
            "type": "null"
          },
          "playerItemSetOccurrenceId": {
            "type": "null"
          },
          "mercenaryItemSetOccurrenceId": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "importedResultSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mercenarySourceMode": {
            "const": "mapped-item-set"
          }
        },
        "required": [
          "mercenarySourceMode"
        ]
      },
      "then": {
        "properties": {
          "mercenaryItemSetOccurrenceId": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "else": {
        "properties": {
          "mercenaryItemSetOccurrenceId": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "manualEquipment": {
      "type": "object",
      "required": [
        "entryId",
        "slotLabel",
        "rawText",
        "reviewState",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "slotLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rawText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "reviewState": {
          "const": "unparsed-manual"
        },
        "note": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "copiedItem": {
      "type": "object",
      "required": [
        "entryId",
        "rawText",
        "role",
        "slotLabel",
        "userLabel",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "entryId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "rawText": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "role": {
          "enum": [
            "player",
            "mercenary",
            "unassigned"
          ]
        },
        "slotLabel": {
          "type": "string",
          "maxLength": 80
        },
        "userLabel": {
          "type": "string",
          "maxLength": 80
        },
        "note": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "decimalText": {
      "type": "string",
      "maxLength": 130,
      "pattern": "^(?=.{1,130}$)-?(?=(?:[^0-9]*[0-9]){1,128}[^0-9]*$)[0-9]+(?:\\.[0-9]+)?$"
    },
    "nullableDecimalText": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/decimalText"
        }
      ]
    },
    "measurementContext": {
      "type": "object",
      "required": [
        "mercenaryIdentityLevel",
        "activeStateSelection",
        "zoneOrUiContext",
        "relevantEffectsConditions",
        "equipmentStateDescription",
        "captureTimingDescription"
      ],
      "additionalProperties": false,
      "properties": {
        "mercenaryIdentityLevel": {
          "type": "string",
          "maxLength": 10000
        },
        "activeStateSelection": {
          "type": "string",
          "maxLength": 10000
        },
        "zoneOrUiContext": {
          "type": "string",
          "maxLength": 10000
        },
        "relevantEffectsConditions": {
          "type": "string",
          "maxLength": 10000
        },
        "equipmentStateDescription": {
          "type": "string",
          "maxLength": 10000
        },
        "captureTimingDescription": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "reviewSourceLocator": {
      "type": "object",
      "required": [
        "provenanceKind",
        "sourceId"
      ],
      "additionalProperties": false,
      "properties": {
        "provenanceKind": {
          "enum": [
            "pob-import",
            "copied-text",
            "manual-entry"
          ]
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "enmityManualInput": {
      "type": "object",
      "required": [
        "finalUncappedFireResistance",
        "maximumFireResistance",
        "equippedState",
        "equipmentInclusionState",
        "measurementContext",
        "targetGameVersionAcknowledgement",
        "observedItemReference",
        "target"
      ],
      "additionalProperties": false,
      "properties": {
        "finalUncappedFireResistance": {
          "$ref": "#/$defs/nullableDecimalText"
        },
        "maximumFireResistance": {
          "$ref": "#/$defs/nullableDecimalText"
        },
        "equippedState": {
          "enum": [
            "equipped",
            "not-equipped",
            "unknown"
          ]
        },
        "equipmentInclusionState": {
          "enum": [
            "unrecorded",
            "included",
            "excluded",
            "unknown"
          ]
        },
        "measurementContext": {
          "$ref": "#/$defs/measurementContext"
        },
        "targetGameVersionAcknowledgement": {
          "enum": [
            "confirmed-3.29.1",
            "other-version",
            "unknown"
          ]
        },
        "observedItemReference": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reviewSourceLocator"
            }
          ]
        },
        "target": {
          "$ref": "#/$defs/nullableDecimalText"
        }
      }
    }
  }
}
