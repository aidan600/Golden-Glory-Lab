{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goldenglorylab.local/schemas/runtime-evidence-gate-v1.schema.json",
  "title": "Golden Glory Lab runtime evidence gate v1",
  "type": "object",
  "required": [
    "resourceType",
    "manifestVersion",
    "targetGameVersion",
    "claims",
    "outputs",
    "sourceArtifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "resourceType": {
      "const": "golden-glory-lab-runtime-evidence-gate"
    },
    "manifestVersion": {
      "const": "1.0.0"
    },
    "targetGameVersion": {
      "const": "Path of Exile 1 3.29.1"
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/output"
      }
    },
    "sourceArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sourceArtifact"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "confirmed",
        "supported",
        "provisional",
        "unknown",
        "superseded"
      ]
    },
    "claim": {
      "type": "object",
      "required": [
        "auditId",
        "contractVersion",
        "claimId",
        "currentClaimStatus",
        "gatePolarity"
      ],
      "additionalProperties": false,
      "properties": {
        "auditId": {
          "pattern": "^AUD-[0-9]{3}$"
        },
        "contractVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "claimId": {
          "pattern": "^AUD-[0-9]{3}-C[0-9]{2}$"
        },
        "currentClaimStatus": {
          "$ref": "#/$defs/status"
        },
        "gatePolarity": {
          "enum": [
            "positive-capability",
            "product-policy"
          ]
        },
        "policyMode": {
          "enum": [
            "requires-adopted-policy",
            "requires-applicable-policy"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "gatePolarity": {
                "const": "product-policy"
              }
            },
            "required": [
              "gatePolarity"
            ]
          },
          "then": {
            "required": [
              "policyMode"
            ]
          },
          "else": {
            "not": {
              "required": [
                "policyMode"
              ]
            }
          }
        }
      ]
    },
    "ordinalRequirement": {
      "type": "object",
      "required": [
        "auditId",
        "contractVersion",
        "claimId",
        "gateMode",
        "minimumStatus",
        "unmetBehavior"
      ],
      "additionalProperties": false,
      "properties": {
        "auditId": {
          "pattern": "^AUD-[0-9]{3}$"
        },
        "contractVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "claimId": {
          "pattern": "^AUD-[0-9]{3}-C[0-9]{2}$"
        },
        "gateMode": {
          "const": "requires-positive-capability"
        },
        "minimumStatus": {
          "enum": [
            "supported",
            "confirmed"
          ]
        },
        "unmetBehavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "policyRequirement": {
      "type": "object",
      "required": [
        "auditId",
        "contractVersion",
        "claimId",
        "policyMode",
        "requiredStatus",
        "unmetBehavior"
      ],
      "additionalProperties": false,
      "properties": {
        "auditId": {
          "pattern": "^AUD-[0-9]{3}$"
        },
        "contractVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "claimId": {
          "pattern": "^AUD-[0-9]{3}-C[0-9]{2}$"
        },
        "policyMode": {
          "enum": [
            "requires-adopted-policy",
            "requires-applicable-policy"
          ]
        },
        "requiredStatus": {
          "$ref": "#/$defs/status"
        },
        "unmetBehavior": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "output": {
      "type": "object",
      "required": [
        "outputId",
        "targetGameVersion",
        "unmetBehavior",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "outputId": {
          "type": "string",
          "minLength": 1
        },
        "targetGameVersion": {
          "const": "Path of Exile 1 3.29.1"
        },
        "unmetBehavior": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/ordinalRequirement"
              },
              {
                "$ref": "#/$defs/policyRequirement"
              }
            ]
          }
        }
      }
    },
    "sourceArtifact": {
      "type": "object",
      "required": [
        "artifactId",
        "repositoryPath",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "artifactId": {
          "type": "string",
          "minLength": 1
        },
        "repositoryPath": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
